{
  "openapi": "3.1.0",
  "info": {
    "title": "OHMSAKTHI Smartflo Integration",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "https://REPLACE_WITH_RENDER_HOST"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
    "/api/status": {
      "get": {
        "operationId": "getIntegrationStatus",
        "summary": "Check integration readiness",
        "responses": {
          "200": {
            "description": "Configuration readiness",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/call-records": {
      "get": {
        "operationId": "getCallRecords",
        "summary": "Read bounded call records",
        "parameters": [
          {
            "name": "from_date",
            "in": "query",
            "required": true,
            "description": "Start in Smartflo account time, YYYY-MM-DD HH:MM:SS",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to_date",
            "in": "query",
            "required": true,
            "description": "End in Smartflo account time, YYYY-MM-DD HH:MM:SS",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "call_type",
            "in": "query",
            "required": false,
            "description": "c for answered, m for missed",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "direction",
            "in": "query",
            "required": false,
            "description": "inbound or outbound",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "did_number",
            "in": "query",
            "required": false,
            "description": "Optional DID filter",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Call records without recordings or private contact details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid filters"
          },
          "401": {
            "description": "Unauthorized"
          },
          "503": {
            "description": "Credentials missing"
          }
        }
      }
    },
    "/api/calls": {
      "post": {
        "operationId": "initiateConfirmedCall",
        "summary": "Initiate a billable agent-to-customer call after explicit confirmation",
        "x-openai-isConsequential": true,
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Unique random request ID. Reuse only for identical retries, never for another call.",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]{16,100}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "agent_number",
                  "destination_number",
                  "confirmed"
                ],
                "properties": {
                  "agent_number": {
                    "type": "string"
                  },
                  "destination_number": {
                    "type": "string"
                  },
                  "caller_id": {
                    "type": "string"
                  },
                  "confirmed": {
                    "type": "boolean",
                    "description": "True only after the user confirms the destination and purpose."
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Provider accepted the request; connection is not confirmed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "409": {
            "description": "Retry conflict or request in progress"
          },
          "503": {
            "description": "Outbound calls disabled or credentials missing"
          }
        }
      }
    }
  }
}
